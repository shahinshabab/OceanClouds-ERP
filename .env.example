# Docker host binding. The existing host Nginx can proxy to 127.0.0.1:8080.
HTTP_PORT=8080

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.oceanclouds.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.oceanclouds.in
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
APP_VERSION=docker
# Logins last until logout or the fixed 12-hour limit. Set minutes here only
# to also sign people out after that long without activity; 0 keeps it off.
LOGIN_IDLE_TIMEOUT_MINUTES=0

# PostgreSQL
DB_ENGINE=postgres
DB_NAME=oceanclouds
DB_USER=oceanclouds
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Live updates (websockets). compose.yaml sets this for the web container;
# leave it empty for local runserver, which then uses an in-memory layer.
REDIS_URL=

# AWS / S3 / SES
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENABLED=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_SES_SENDER=

# Email
EMAIL_SENDING_ENABLED=True
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=

# WhatsApp
WHATSAPP_SENDING_ENABLED=False
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v22.0
MSG91_AUTHKEY=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
